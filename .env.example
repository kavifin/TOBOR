# Copy to .env and fill in. Everything is optional in development.

# Team dashboard password (/admin). Required in production.
ADMIN_KEY=change-me

# Public address of the site, used in WhatsApp links and the phone QR code.
PUBLIC_URL=https://tobor.in

# Razorpay — UPI, cards, net banking. Without these, checkout runs in clearly-labelled test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Vercel storage. Both are set for you when you connect them to the Vercel project (Storage tab):
# DATABASE_URL by a Neon Postgres database (orders, photo requests, enquiries), and
# BLOB_READ_WRITE_TOKEN by a Blob store (customer photos and model files). Leave both empty on this
# computer: records then go to server/data/db.json and uploads to server/uploads.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# WhatsApp Cloud API (Meta). Without these, messages are logged with one-click "send on WhatsApp" links in /admin.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Optional approved template name with one body parameter, needed to message customers outside the 24h window.
WHATSAPP_TEMPLATE=

# Enquiry emails (footer "Ask us anything" form): sent to BUSINESS_EMAIL, with a confirmation to
# the customer. Uses Brevo's free plan. In Brevo: verify roboattis@gmail.com as a sender
# (Senders, Domains & Dedicated IPs), then create an API key (SMTP & API -> API Keys) and paste it below.
# Without a key, enquiries are still saved in /admin and the emails are only written to the log.
BREVO_API_KEY=
MAIL_FROM=roboattis@gmail.com
BUSINESS_EMAIL=roboattis@gmail.com
# Alternative to Brevo: any SMTP account, e.g. Gmail with an App Password.
# SMTP_USER=roboattis@gmail.com
# SMTP_PASS=

# Business details shown on the site (browser-side, so prefix VITE_).
# Address, map and hours live in src/lib/config.js.
VITE_WHATSAPP_NUMBER=918072051063
VITE_CONTACT_PHONE=+91 80720 51063
VITE_CONTACT_EMAIL=roboattis@gmail.com
